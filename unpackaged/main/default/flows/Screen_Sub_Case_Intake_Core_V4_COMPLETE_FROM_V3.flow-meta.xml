    <formulas>
        <name>formula_EUNameTrim</name>
        <dataType>String</dataType>
        <expression>TRIM({!Input_EndUser_Name})</expression>
    </formulas>
    <formulas>
        <name>formula_EUOptTrim</name>
        <dataType>String</dataType>
        <expression>{!EndUser_Lookup_Optional.recordId}</expression>
    </formulas>
    <formulas>
        <name>formula_HasAccount</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inp_AccountId}))</expression>
    </formulas>
    <formulas>
        <name>formula_HasCaseId</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inp_CaseId}))</expression>
    </formulas>
    <formulas>
        <name>formula_HasContact</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inp_ContactId}))</expression>
    </formulas>
    <formulas>
        <name>formula_HasPhone</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inp_Phone}))</expression>
    </formulas>
    <formulas>
        <name>formula_Origin</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!inp_Origin}), {!Origin_Pick}, {!inp_Origin})</expression>
    </formulas>
    <formulas>
        <description>Last 8 digits of the normalized input phone number</description>
        <name>formula_PhoneLast8</name>
        <dataType>String</dataType>
        <expression>RIGHT(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!inp_Phone},&quot; &quot;,&quot;&quot;),&quot;-&quot;,&quot;&quot;),&quot;(&quot;,&quot;&quot;),&quot;)&quot;,&quot;&quot;),&quot;+&quot;,&quot;&quot;),&quot;.&quot;,&quot;&quot;),&quot;/&quot;,&quot;&quot;), 8)</expression>
    </formulas>
    <formulas>
        <name>formula_Range</name>
        <dataType>String</dataType>
        <expression>IF({!BU_Pick}=&#39;Equipment&#39;, {!Range_Equipment}, IF({!BU_Pick}=&#39;Imaging&#39;, {!Range_Imaging}, IF({!BU_Pick}=&#39;Instrumentation&#39;, {!Range_Instrumentation}, IF({!BU_Pick}=&#39;Medical&#39;, {!Range_Medical}, IF({!BU_Pick}=&#39;Other&#39;, {!Range_Other}, IF({!BU_Pick}=&#39;Pharma&#39;, {!Range_Pharma}, IF({!BU_Pick}=&#39;Owandy&#39;, {!Range_Owandy}, &#39;&#39;)))))))</expression>
    </formulas>
    <formulas>
        <name>formula_SousType</name>
        <dataType>String</dataType>
        <expression>IF({!Thematic_Pick}=&#39;Product Problem&#39;, {!SousType_PP}, IF({!Thematic_Pick}=&#39;Product use&#39;, {!SousType_PU}, IF({!Thematic_Pick}=&#39;Demande non-technique&#39;, {!SousType_NT}, {!SousType_GC})))</expression>
    </formulas>
